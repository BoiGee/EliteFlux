# Copy to .env and fill in real values locally. Never put real secrets in
# this file — it's the one meant to be safe to commit. .env itself is
# gitignored; keep it that way.
#
# Production values belong in Lovable's project environment settings
# (or your actual host's secrets manager), not in a checked-in file.

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ANTHROPIC_API_KEY=
PORTFOLIO_VAULT_SECRET=
ALERT_WEBHOOK_SECRET=
APP_URL=
VITE_ENABLE_MARKET_WS=
ETHERSCAN_API_KEY=
PAYSTACK_SECRET_KEY=
