# Copy to .env and fill in real values locally. Never put real secrets in
# this file — it's the one meant to be safe to commit. .env itself is
# gitignored; keep it that way.
#
# Production values belong in your Cloudflare Worker's secrets
# (`wrangler secret put <NAME>` or `wrangler secret bulk .env`), not in a
# checked-in file.

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ANTHROPIC_API_KEY=
PORTFOLIO_VAULT_SECRET=
ALERT_WEBHOOK_SECRET=
APP_URL=
VITE_ENABLE_MARKET_WS=
ETHERSCAN_API_KEY=
# Comma-separated "LABEL:address" pairs to watch beyond the built-in seed
# exchange wallets (see onchain-intel.ts). Optional — has a default list.
ETHERSCAN_WATCH_WALLETS=
PAYSTACK_SECRET_KEY=
# Optional — raises CoinGecko rate limits. Falls back to unauthenticated
# public API calls when unset.
COINGECKO_API_KEY=
# Required for transactional email (password reset, etc. — see
# email.server.ts). Without both set, email sending silently no-ops.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
