{
  // Custom domains (elite-flux.com, www.elite-flux.com) are attached directly
  // via the Cloudflare Workers Custom Domains API, not listed here — the
  // token used for `wrangler deploy` only has Workers Scripts:Edit, not the
  // zone-level Workers Routes:Edit that `routes` in this file would need.
  "name": "eliteflux",
  // Each pattern must exactly match a key in scheduler.server.ts's CRON_JOBS.
  "triggers": {
    "crons": [
      "* * * * *",
      "*/5 * * * *",
      "0 * * * *",
      "0 */12 * * *",
      "0 3 * * *"
    ]
  },
  // Explicit rather than relying on the paid-plan default (10,000) applying
  // automatically — confirmed live this account kept throttling at the
  // free-plan ceiling (50) for a while after upgrading to Workers Paid, a
  // known class of issue where the new entitlement doesn't take effect on
  // its own. Setting this directly is unambiguous regardless of account-side
  // propagation delay.
  "limits": {
    "subrequests": 10000
  }
}
