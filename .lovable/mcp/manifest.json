{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://pzngtzltmkdjmltxtkaa.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "eliteflux-insights",
      "version": "0.1.0",
      "title": "EliteFlux Insights"
    },
    "tools": [
      {
        "name": "get_market_intelligence",
        "title": "Get market intelligence",
        "description": "Current EliteFlux market intelligence: ELITE FLUX SCORE, market regime, whale phase, sentiment, narratives and pump pressure from live Binance/CoinGecko data. Depth of the response depends on the signed-in user's plan.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_coin_intel",
        "title": "Get coin intelligence",
        "description": "Per-asset EliteFlux intelligence: price, 24h change, momentum score, risk level, BTC correlation and flow direction. Full per-coin signals require the PRO plan.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "symbols": {
              "description": "Ticker symbols to filter on, e.g. ['BTC','SOL']. Omit for the whole universe.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_my_subscription",
        "title": "Get my subscription",
        "description": "Read the signed-in user's EliteFlux plan tier, status and current billing period.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_watchlist",
        "title": "List my watchlist",
        "description": "List the coins on the signed-in user's EliteFlux watchlists.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "add_to_watchlist",
        "title": "Add coin to watchlist",
        "description": "Add a coin symbol to the signed-in user's default EliteFlux watchlist.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string",
              "description": "Ticker symbol, e.g. SOL"
            },
            "coin_name": {
              "description": "Optional display name for the coin.",
              "type": "string"
            }
          },
          "required": [
            "symbol"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "remove_from_watchlist",
        "title": "Remove coin from watchlist",
        "description": "Remove a coin symbol from the signed-in user's EliteFlux watchlists.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string",
              "description": "Ticker symbol to remove, e.g. SOL"
            }
          },
          "required": [
            "symbol"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_alerts",
        "title": "List my alerts",
        "description": "List the signed-in user's EliteFlux alerts with their trigger type, threshold and status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "create_alert",
        "title": "Create an alert",
        "description": "Create an EliteFlux alert for the signed-in user (e.g. flux score crossing a threshold or a price level).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Short alert name."
            },
            "trigger_type": {
              "type": "string",
              "enum": [
                "flux_score",
                "whale_spike",
                "sentiment_shift",
                "narrative_surge",
                "exit_pressure",
                "momentum_change",
                "price_threshold"
              ],
              "description": "What the alert watches."
            },
            "symbol": {
              "description": "Ticker symbol the alert applies to, e.g. BTC.",
              "type": "string"
            },
            "threshold": {
              "description": "Numeric threshold that triggers the alert.",
              "type": "number"
            },
            "direction": {
              "description": "Direction relative to the threshold.",
              "type": "string",
              "enum": [
                "above",
                "below"
              ]
            },
            "channels": {
              "description": "Delivery channels. Defaults to in_app.",
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "in_app",
                  "email",
                  "telegram",
                  "webhook"
                ]
              }
            }
          },
          "required": [
            "name",
            "trigger_type"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
